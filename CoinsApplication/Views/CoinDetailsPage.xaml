<Page x:Class="CoinsApplication.Views.CoinDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Coin Details"
      Background="{DynamicResource BackgroundMain}">

    <Grid>
        <StackPanel Margin="10">
            
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding Symbol}" FontSize="18"/>
            <TextBlock x:Name="PriceColumn" Text="{Binding Quote.USD.Price, StringFormat='Price: {0:C}'}" FontSize="18"/>
            <TextBlock x:Name="MarketCapColumn" Text="{Binding Quote.USD.MarketCap, StringFormat='Market Cap: {0:C}'}" FontSize="18"/>
            <TextBlock x:Name="Change1hColumn" Text="{Binding Quote.USD.PercentChange1h, StringFormat='1h Change: {0:F2}%'}" FontSize="18"/>
            <TextBlock x:Name="Change24hColumn" Text="{Binding Quote.USD.PercentChange24h, StringFormat='24h Change: {0:F2}%'}" FontSize="18"/>
            <TextBlock x:Name="Change7dColumn" Text="{Binding Quote.USD.PercentChange7d, StringFormat='7d Change: {0:F2}%'}" FontSize="18"/>
        </StackPanel>
    </Grid>
</Page>