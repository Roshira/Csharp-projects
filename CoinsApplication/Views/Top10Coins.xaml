<Page x:Class="CoinsApplication.Views.Top10Coins"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:CoinsApplication.Services"
      Title="Top 10 Cryptocurrencies">

    <Page.Resources>
        <local:ColorConverterService x:Key="ColorConverterService"/>
    </Page.Resources>

    <Grid>
        <TextBlock Text="Top 10 Cryptocurrencies"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="10"/>

        <ListView ItemsSource="{Binding Cryptos}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Symbol}" Width="80"/>
                    <GridViewColumn Header="Price (USD)" DisplayMemberBinding="{Binding Quote.USD.Price}" Width="100"/>
                    <GridViewColumn Header="Market Cap" DisplayMemberBinding="{Binding Quote.USD.MarketCap}" Width="150"/>

                    <GridViewColumn Header="Change 1h">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quote.USD.PercentChange1h, StringFormat=F2}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quote.USD.PercentChange1h, Converter={StaticResource ColorConverterService}}" Value="Positive">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quote.USD.PercentChange1h, Converter={StaticResource ColorConverterService}}" Value="Negative">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
