<Window x:Class="CoinsApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoApp" Height="500" Width="800">

    <Grid>
        <DockPanel Background="{DynamicResource BackgroundMain}">

            <!-- Верхня панель -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" Width="739">
                <ToggleButton Name="BtnSwitchTheme"
  Content="🌙"
  ToolTip="Switch Theme"
  Click="BtnSwitchTheme_Click"
  Width="40" Height="30"
  HorizontalAlignment="Right"
  VerticalAlignment="Top"
  Margin="10"
  Background="LightGray"
  Foreground="Black"
  BorderBrush="Gray"
  FontSize="16"
  FontWeight="Bold" RenderTransformOrigin="0.462,-0.797"/>
                <StackPanel Orientation="Horizontal" Width="334" Margin="150,0,0,0">
                    <Button Name="BtnTop10" Content="Top 10 Cryptos" Click="BtnTop10_Click" Width="150" Margin="5"/>
                    <Button Name="AllCoins" Content="All Coins" Click="AllCoins_" Width="150" Margin="5" RenderTransformOrigin="0.497,0.551"/>
                </StackPanel>

            </StackPanel>

            <!-- Перемикач теми у правому верхньому куті -->


            <Frame Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </DockPanel>
    </Grid>
</Window>